# Ghostty Terminal Configuration - Linux
# 👻 Terminal moderno e rápido

# ═══════════════════════════════════════════════════════════
# Shell (usa o shell padrão do sistema)
# ═══════════════════════════════════════════════════════════
shell-integration = detect

# ═══════════════════════════════════════════════════════════
# Theme
# ═══════════════════════════════════════════════════════════
# >>> tema:nome inicio (gerenciado por scripts/set_theme.sh; edicoes manuais aqui serao perdidas) >>>
theme = Catppuccin Mocha
# <<< tema:nome fim <<<
background-opacity = 0.95

# ═══════════════════════════════════════════════════════════
# Font
# ═══════════════════════════════════════════════════════════
font-family = JetBrainsMono Nerd Font
font-size = 12.5
font-feature = liga
font-feature = zero
font-feature = ss01
font-feature = cv01

# ═══════════════════════════════════════════════════════════
# Cursor
# ═══════════════════════════════════════════════════════════
cursor-style = block
cursor-style-blink = true

# ═══════════════════════════════════════════════════════════
# Window
# ═══════════════════════════════════════════════════════════
window-padding-x = 8
window-padding-y = 6
window-decoration = client

# ═══════════════════════════════════════════════════════════
# Behavior
# ═══════════════════════════════════════════════════════════
copy-on-select = true
clipboard-read = allow
clipboard-write = allow
confirm-close-surface = false

# ═══════════════════════════════════════════════════════════
# Performance & Developer Features
# ═══════════════════════════════════════════════════════════
scrollback-limit = 20000

# Better rendering for complex Unicode (emojis, icons, box drawing)
grapheme-width-method = unicode

shell-integration-features = cursor,sudo,title

# ═══════════════════════════════════════════════════════════
# Keybindings (Browser-like + Developer workflow)
# ═══════════════════════════════════════════════════════════
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab
keybind = ctrl+shift+n=new_window
keybind = alt+left=previous_tab
keybind = alt+right=next_tab
keybind = shift+enter=text:\x1b\r

# Quick splits (useful for Docker + dev server side by side)
keybind = ctrl+shift+d=new_split:right
# Use tmux-like split below
keybind = ctrl+shift+s=new_split:down

# Font size adjustment (zoom in/out)
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Search in terminal (useful for long logs)
keybind = ctrl+shift+f=toggle_quick_terminal
